{
  "name": "steelhacks-2026",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @steelhacks-2026/db --",
    "db:studio": "turbo run db:studio -F @steelhacks-2026/db --",
    "db:generate": "turbo run db:generate -F @steelhacks-2026/db --",
    "db:migrate": "turbo run db:migrate -F @steelhacks-2026/db --",
    "db:seed": "turbo run db:seed -F web --",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && pnpm run auth:generate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@steelhacks-2026/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "catalog:",
    "vercel": "^59.11.7"
  },
  "packageManager": "pnpm@12.4.2"
}
