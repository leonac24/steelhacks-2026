# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Unpooled Neon URL for drizzle-kit (schema push/migrate). Falls back to DATABASE_URL.
# @required=false
DATABASE_URL_DIRECT=

# Where bank data comes from. `mock` serves the seeded DB rows.
# @type=enum(mock, plaid)
BANK_PROVIDER=mock

# Turns on the dev.* procedures (inject transaction, run alerts) outside
# development, e.g. on the Vercel deploy used for the live demo.
# @required=false @type=boolean
DEV_TOOLS_ENABLED=false

# Plaid Sandbox credentials (https://dashboard.plaid.com/developers/keys).
# @required=false
PLAID_CLIENT_ID=

# @required=false
PLAID_SECRET=

# @required=false @type=enum(sandbox, production)
PLAID_ENV=sandbox

# Proactive calls through ElevenLabs' Twilio integration. Without these the
# alerts engine logs the call it would place instead of dialing.
# @required=false
ELEVENLABS_API_KEY=

# @required=false
ELEVENLABS_AGENT_ID=

# @required=false
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Shared secret for the /api/cron/* endpoints (Authorization: Bearer ...).
# @required=false
CRON_SECRET=
