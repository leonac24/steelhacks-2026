# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Unpooled Neon URL for drizzle-kit (schema push/migrate). Falls back to DATABASE_URL.
# @required=false
DATABASE_URL_DIRECT=

# Which BankDataProvider backs bank_connection/bank_account/transaction reads.
# @public @type=enum(mock, plaid)
BANK_PROVIDER=mock

# Required when BANK_PROVIDER=plaid.
# @required=false @type=string(minLength=1)
PLAID_CLIENT_ID=

# Required when BANK_PROVIDER=plaid.
# @required=false @type=string(minLength=1)
PLAID_SECRET=

# Plaid's own environment, not NODE_ENV. Sandbox for the whole hackathon.
# @type=enum(sandbox, development, production)
PLAID_ENV=sandbox

# TODO: not yet checked anywhere. /api/plaid/webhook accepts any request for
# now; wire this in once webhook signature verification is implemented.
# https://plaid.com/docs/api/webhooks/webhook-verification/
# @required=false
PLAID_WEBHOOK_SECRET=
