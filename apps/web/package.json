{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b ../../packages/api && vite build",
    "serve": "vite preview",
    "dev": "vite dev",
    "check-types": "tsc -b ../../packages/api && vite build && tsc --noEmit",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "db:seed": "varlock run -- tsx scripts/seed.ts",
    "sync:agent": "varlock run -- tsx scripts/sync-agent.ts"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@orpc/zod": "catalog:",
    "@steelhacks-2026/api": "workspace:*",
    "@steelhacks-2026/auth": "workspace:*",
    "@steelhacks-2026/db": "workspace:*",
    "@steelhacks-2026/finance": "workspace:*",
    "@steelhacks-2026/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@varlock/vite-integration": "1.5.1",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "nitro": "3.0.260903-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@steelhacks-2026/config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "web-vitals": "^6.2.1"
  }
