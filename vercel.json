{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "tanstack-start",
      "installCommand": "cd ../.. && pnpm install"
    }
  },
  "crons": [
    { "path": "/api/cron/alerts", "schedule": "0 13 * * *" },
    { "path": "/api/cron/approvals", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
