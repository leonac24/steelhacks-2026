{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "tanstack-start",
      "installCommand": "cd ../.. && pnpm install"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-alerts",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/process-approvals",
      "schedule": "30 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
